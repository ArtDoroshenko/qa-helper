# Compose and HTTPS
SITE_DOMAIN=qa-helper-artem.duckdns.org
ACME_EMAIL=admin@example.com

# Django: replace the placeholder secret before starting containers.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=qa-helper-artem.duckdns.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://qa-helper-artem.duckdns.org
DJANGO_TRUST_X_FORWARDED_PROTO=1
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False

# Optional feedback mailbox. Use SMTP over STARTTLS and a dedicated app password.
QA_FEEDBACK_ENABLED=0
QA_FEEDBACK_FROM=
QA_FEEDBACK_TO=
QA_FEEDBACK_SMTP_HOST=
QA_FEEDBACK_SMTP_PORT=587
QA_FEEDBACK_SMTP_USER=
QA_FEEDBACK_SMTP_PASSWORD=
