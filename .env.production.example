# Compose and HTTPS
SITE_DOMAIN=qa-helper-artem.duckdns.org
ACME_EMAIL=admin@example.com

# Django: replace every placeholder secret before starting containers.
DJANGO_PRODUCTION=True
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=qa-helper-artem.duckdns.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://qa-helper-artem.duckdns.org
DJANGO_ACCOUNT_ALLOW_SIGNUPS=False
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_TRUST_X_FORWARDED_PROTO=True
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=no-reply@qa-helper-artem.duckdns.org

# PostgreSQL
POSTGRES_ADMIN_USER=qa_helper_admin
POSTGRES_ADMIN_PASSWORD=replace-with-a-separate-admin-password
DB_NAME=qa_helper
DB_USER=qa_helper_app
DB_PASSWORD=replace-with-a-long-random-password
DB_HOST=db
DB_PORT=5432

# One worker is intentional for a 1 GiB demo server.
GUNICORN_WORKERS=1
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=30
