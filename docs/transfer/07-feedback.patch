+    color: var(--ink);
+    background: var(--surface);
+}
+.feedback-dialog::backdrop { background: rgb(12 18 28 / 55%); }
+.feedback-dialog:not([open]) { display: none; }
+.feedback-dialog h2 { margin: 0 0 8px; font-size: 20px; font-weight: 600; }
+.feedback-form { display: grid; gap: var(--qa-gap); margin-top: var(--qa-gap); }
+.feedback-field { display: grid; gap: 6px; }
+.feedback-field label { font-size: 13px; font-weight: 500; }
