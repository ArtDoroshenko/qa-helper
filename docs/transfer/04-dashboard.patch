diff --git a/templates/tools_dashboard.html b/templates/tools_dashboard.html
new file mode 100644
index 0000000..c63f818
--- /dev/null
+++ b/templates/tools_dashboard.html
@@ -0,0 +1,26 @@
+{% extends "base.html" %}
+{% load static %}
+{% block head_title %}Инструменты QA Helper{% endblock head_title %}
+{% block extra_head %}
+<link rel="stylesheet" href="{% static 'css/dashboard.css' %}?v=1">
+{% endblock extra_head %}
+{% block body %}
+<div class="workspace">
+    {% include "includes/sidebar.html" with active="home" %}
+    <main class="dashboard tools-home">
+        <h1>Инструменты QA Helper</h1>
+        <p class="lead">Выберите инструмент. Введённые данные и результаты не сохраняются на сайте.</p>
+        <nav class="tool-grid" aria-label="Доступные инструменты">
+            {% for route, icon, title, description in tools %}
+                <a class="tool-card" href="{% url route %}">
+                    <span class="tool-icon" aria-hidden="true">{% include "includes/icon.html" with name=icon %}</span>
+                    <div>
+                        <h2>{{ title }}</h2>
+                        <p>{{ description }}</p>
+                    </div>
+                </a>
+            {% endfor %}
+        </nav>
+    </main>
+</div>
+{% endblock body %}
