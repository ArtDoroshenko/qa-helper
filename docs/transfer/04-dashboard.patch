diff --git a/static/css/dashboard.css b/static/css/dashboard.css
new file mode 100644
index 0000000..9fe4e7e
--- /dev/null
+++ b/static/css/dashboard.css
@@ -0,0 +1,20 @@
+.tools-home .tool-card {
+    display: grid;
+    grid-template-columns: auto minmax(0, 1fr);
+    align-items: start;
+    gap: var(--qa-gap);
+    min-height: 0;
+    padding: 16px;
+    color: var(--ink);
+    text-decoration: none;
+}
+.tools-home .tool-card:hover { border-color: var(--accent); background: var(--hover); }
+.tools-home .tool-card:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
+.tools-home .tool-card h2 { margin: 0 0 5px; font-size: 15px; font-weight: 600; }
+.tools-home .tool-icon { margin: 0; }
+@media (max-width: 1020px) {
+    .tools-home .tool-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+}
+@media (max-width: 700px) {
+    .tools-home .tool-grid { grid-template-columns: minmax(0, 1fr); }
+}
