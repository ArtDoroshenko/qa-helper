@@ -0,0 +1,212 @@
+(() => {
+    "use strict";
+    const form = document.getElementById("base64-tool-form");
+    if (!form) return;
+    form.classList.add("is-enhanced");
+
+    const modeButtons = Array.from(form.querySelectorAll("[data-base64-mode]"));
+    const textSource = form.querySelector("[data-base64-text-source]");
+    const fileSource = form.querySelector("[data-base64-file-source]");
+    const textInput = document.getElementById("id_text");
+    const fileInput = document.getElementById("id_file");
+    const operation = document.getElementById("id_operation");
+    const sourceTitle = form.querySelector("[data-base64-source-title]");
+    const dataUrlField = form.querySelector("[data-base64-data-url]");
+    const dataUrlInput = document.getElementById("id_as_data_url");
+    const output = form.querySelector("[data-base64-output]");
+    const resultMeta = form.querySelector("[data-base64-result-meta]");
+    const status = form.querySelector("[data-base64-status]");
+    const copyButton = form.querySelector("[data-base64-copy]");
+    const downloadButton = document.getElementById("base64-download-button");
+    const preview = form.querySelector("[data-base64-preview]");
+    const fileName = form.querySelector("[data-base64-file-name]");
+    const dropZone = form.querySelector("[data-base64-drop]");
+    const submitButton = form.querySelector(".base64-submit");
+    const previewBytes = 8 * 1024;
+    const previewImageBytes = 1024 * 1024;
+    const previewTypes = new Set(["image/png", "image/jpeg", "image/gif", "image/webp"]);
+    const responseErrors = {
+        413: "Запрос слишком большой.",
+        503: "Конвертер занят. Попробуйте ещё раз через несколько секунд.",
+    };
+    const utf8 = () => new TextDecoder("utf-8", {ignoreBOM: true});
+    let pending = null;
+    let result = null;
+    let previewUrl = null;
+
+    const feedback = (message, error = false) => {
+        status.textContent = message;
+        status.classList.toggle("error", error);
+    };
+
+    const clearPreview = () => {
+        preview.hidden = true;
+        preview.removeAttribute("src");
+        if (previewUrl) URL.revokeObjectURL(previewUrl);
+        previewUrl = null;
+    };
+
+    const invalidate = (message = "Данные изменены. Преобразуйте снова.") => {
+        pending?.abort();
+        pending = null;
+        result = null;
+        output.value = "";
+        clearPreview();
+        copyButton.disabled = true;
+        downloadButton.disabled = true;
+        submitButton.disabled = false;
+        resultMeta.textContent = "UTF-8 · текст или файл";
+        feedback(message);
+    };
+
+    const setMode = (mode) => {
+        const isText = mode === "text";
+        textSource.hidden = !isText;
+        fileSource.hidden = isText;
+        textInput.disabled = !isText;
+        fileInput.disabled = isText;
+        modeButtons.forEach((button) => {
+            button.setAttribute("aria-pressed", String(button.dataset.base64Mode === mode));
+        });
+        sourceTitle.textContent = isText
+            ? (operation.value === "encode" ? "Исходный текст" : "Строка Base64")
+            : (operation.value === "encode" ? "Исходный файл" : "Файл с Base64");
+    };
+
+    const syncOperation = () => {
+        const isEncode = operation.value === "encode";
+        dataUrlField.hidden = !isEncode;
+        dataUrlInput.disabled = !isEncode;
+        const activeMode = modeButtons.find((button) => button.getAttribute("aria-pressed") === "true");
+        setMode(activeMode?.dataset.base64Mode || "text");
+    };
+
+    modeButtons.forEach((button) => {
+        button.addEventListener("click", () => { setMode(button.dataset.base64Mode); invalidate(); });
+    });
+    operation.addEventListener("change", () => { syncOperation(); invalidate(); });
+    textInput.addEventListener("input", () => invalidate());
+    dataUrlInput.addEventListener("change", () => invalidate());
+    form.querySelector("[name='output_name']").addEventListener("input", () => invalidate());
+
+    fileInput.addEventListener("change", () => {
+        fileName.textContent = fileInput.files[0]?.name || "Перетащите файл сюда или выберите на устройстве";
+        invalidate();
+        status.textContent = fileInput.files[0] ? "Файл выбран. Преобразуйте снова." : "Файл не выбран.";
+    });
+
+    ["dragenter", "dragover"].forEach((eventName) => {
+        dropZone.addEventListener(eventName, (event) => {
+            event.preventDefault();
+            dropZone.classList.add("is-dragging");
+        });
+    });
+    ["dragleave", "drop"].forEach((eventName) => {
+        dropZone.addEventListener(eventName, (event) => {
+            event.preventDefault();
+            dropZone.classList.remove("is-dragging");
+        });
+    });
+    dropZone.addEventListener("drop", (event) => {
+        if (!event.dataTransfer.files.length) return;
+        fileInput.files = event.dataTransfer.files;
+        fileInput.dispatchEvent(new Event("change"));
+    });
+
+    form.querySelector("[data-base64-clear]").addEventListener("click", () => {
+        textInput.value = "";
+        fileInput.value = "";
+        fileName.textContent = "Перетащите файл сюда или выберите на устройстве";
+        invalidate("Очищено");
+        (textInput.disabled ? fileInput : textInput).focus();
+    });
+
+    copyButton.addEventListener("click", async () => {
+        const current = result;
+        if (!current?.isText || copyButton.disabled) return;
+        copyButton.disabled = true;
+        try {
+            if (navigator.clipboard.write && typeof ClipboardItem === "function") {
+                const textBlob = current.blob.slice(0, current.blob.size, "text/plain");
+                await navigator.clipboard.write([new ClipboardItem({"text/plain": textBlob})]);
+            } else {
+                const text = utf8().decode(await current.blob.arrayBuffer());
+                if (current !== result) return;
+                await navigator.clipboard.writeText(text);
+            }
+            if (current === result) feedback("Скопирован весь результат.");
+        } catch {
+            if (current === result) feedback("Не удалось скопировать результат. Его можно скачать.", true);
+        } finally {
+            if (current === result) copyButton.disabled = false;
+        }
+    });
+
+    downloadButton.addEventListener("click", () => {
+        if (!result) return;
+        const url = URL.createObjectURL(result.blob);
+        const link = document.createElement("a");
+        link.href = url;
+        link.download = result.filename;
+        link.click();
+        window.setTimeout(() => URL.revokeObjectURL(url), 1000);
+    });
+
+    function filenameFrom(response) {
+        const disposition = response.headers.get("Content-Disposition") || "";
+        const utf8Name = disposition.match(/filename\*=utf-8''([^;]+)/i);
+        return utf8Name ? decodeURIComponent(utf8Name[1])
+            : disposition.match(/filename="([^"]+)"/i)?.[1] || "result.bin";
+    }
+
+    form.addEventListener("submit", async event => {
+        event.preventDefault();
+        invalidate("Обрабатываем…");
+        const job = new AbortController();
+        pending = job;
+        submitButton.disabled = true;
+        const encoded = operation.value === "encode";
+        const selectedFile = fileInput.disabled ? null : fileInput.files[0];
+        try {
+            const response = await fetch(form.action, {
+                method: "POST", body: new FormData(form), credentials: "same-origin", signal: job.signal,
+            });
+            if (!response.ok) {
+                const error = await response.json().catch(() => null);
+                throw new Error(error?.error || responseErrors[response.status] || "Не удалось преобразовать данные.");
+            }
+            const blob = await response.blob();
+            if (pending !== job) return;
+            const isText = response.headers.get("X-QA-Result-Text") === "1";
+            const truncated = isText && blob.size > previewBytes;
+            const text = isText
+                ? utf8().decode(await blob.slice(0, previewBytes).arrayBuffer(), {stream: truncated})
+                : "Двоичный результат готов к скачиванию.";
+            if (pending !== job) return;
+            result = {blob, isText, filename: filenameFrom(response)};
+            output.value = text;
+            resultMeta.textContent = truncated ? "Первые 8 КиБ · копирование и скачивание целиком" : "Результат готов";
+            const previewType = response.headers.get("X-QA-Preview-Type");
+            const image = encoded ? selectedFile : blob;
+            if (image && image.size <= previewImageBytes && previewTypes.has(previewType)) {
+                previewUrl = URL.createObjectURL(image.slice(0, image.size, previewType));
+                preview.src = previewUrl;
+                preview.hidden = false;
+            }
+            copyButton.disabled = !isText;
+            downloadButton.disabled = false;
+            feedback("Готово");
+        } catch (error) {
+            if (pending === job) feedback(error.message || "Не удалось преобразовать данные.", true);
+        } finally {
+            if (pending === job) {
+                pending = null;
+                submitButton.disabled = false;
+            }
+        }
+    });
+    preview.addEventListener("error", clearPreview);
+    window.addEventListener("pagehide", () => invalidate(""));
+
+    syncOperation();
+})();
diff --git a/static/js/json_public.js b/static/js/json_public.js
new file mode 100644
index 0000000..aafa3c8
--- /dev/null
+++ b/static/js/json_public.js
@@ -0,0 +1,151 @@
+(() => {
+    "use strict";
+    const form = document.querySelector("[data-json-tool]");
+    if (!form) return;
+    const source = form.querySelector("[data-json-source]");
+    const output = form.querySelector("[data-json-output]");
+    const status = form.querySelector("[data-json-status]");
+    const copy = form.querySelector("[data-json-copy]");
+    const download = form.querySelector("[data-json-download]");
+    const indent = form.querySelector("[data-json-indent]");
+    const sort = form.querySelector("[data-json-sort]");
+    const file = form.querySelector("[data-json-file]");
+    const tabs = [...document.querySelectorAll("[data-json-lab-tab]")];
+    const panels = {
+        analyzer: document.querySelector("[data-json-analyzer]"),
+        compare: document.querySelector("[data-json-compare]"),
+    };
+    let operation = "format", revision = 0, result = null, controller = null;
+    const tokenPattern = /("(?:\\.|[^"\\])*")(?=\s*:)|("(?:\\.|[^"\\])*")|(-?\d+(?:\.\d+)?(?:[eE][+-]?\d+)?)|\b(true|false|null)\b/g;
+    const paint = value => {
+        output.replaceChildren();
+        let last = 0;
+        for (const match of value.matchAll(tokenPattern)) {
+            output.append(document.createTextNode(value.slice(last, match.index)));
+            const span = document.createElement("span");
+            span.className = match[1] ? "json-key" : match[2] ? "json-string" : match[3] ? "json-number" : "json-literal";
+            span.textContent = match[0];
+            output.append(span);
+            last = match.index + match[0].length;
+        }
+        output.append(document.createTextNode(value.slice(last)));
+    };
+    const message = (value, error = false) => {
+        status.textContent = value;
+        status.classList.toggle("error", error);
+    };
+    const invalidate = () => {
+        revision++;
+        controller?.abort();
+        result = null;
+        paint("");
+        copy.disabled = true;
+        download.disabled = true;
+        message("");
+    };
+    const payload = () => {
+        const data = new FormData();
+        data.set("csrfmiddlewaretoken", form.querySelector('[name="csrfmiddlewaretoken"]').value);
+        data.set("source", source.value);
+        data.set("operation", operation);
+        data.set("indent", indent.value);
+        if (sort.checked) data.set("sort_keys", "on");
+        return data;
+    };
+    tabs.forEach((tab, index) => {
+        const activate = (selected) => {
+            for (const [name, panel] of Object.entries(panels)) panel.hidden = name !== selected;
+            for (const button of tabs) {
+                const active = button.dataset.jsonLabTab === selected;
+                button.setAttribute("aria-selected", String(active));
+                button.tabIndex = active ? 0 : -1;
+            }
+        };
+        tab.addEventListener("click", () => activate(tab.dataset.jsonLabTab));
+        tab.addEventListener("keydown", event => {
+            if (!["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key)) return;
+            event.preventDefault();
+            const target = event.key === "Home" ? 0 : event.key === "End" ? tabs.length - 1
+                : (index + (event.key === "ArrowRight" ? 1 : -1) + tabs.length) % tabs.length;
+            tabs[target].focus();
+            activate(tabs[target].dataset.jsonLabTab);
+        });
+    });
+    form.addEventListener("submit", async event => {
+        event.preventDefault();
+        invalidate();
+        const current = revision;
+        controller = new AbortController();
+        message("Проверяем…");
+        try {
+            const response = await fetch(form.dataset.processUrl, {
+                method: "POST", credentials: "same-origin", body: payload(), signal: controller.signal,
+            });
+            const data = await response.json();
+            if (current !== revision) return;
+            if (!response.ok || !data.ok) throw new Error(data.error || "Не удалось обработать JSON.");
+            result = data.result;
+            paint(result);
+            copy.disabled = false;
+            download.disabled = false;
+            message("Готово");
+        } catch (error) {
+            if (error.name !== "AbortError" && current === revision)
+                message(error.message || "Не удалось обработать JSON.", true);
+        }
+    });
+    source.addEventListener("input", invalidate);
+    indent.addEventListener("change", invalidate);
+    sort.addEventListener("change", invalidate);
+    form.querySelectorAll("[data-json-operation]").forEach(button => button.addEventListener("click", () => {
+        operation = button.dataset.jsonOperation;
+        form.querySelectorAll("[data-json-operation]").forEach(item =>
+            item.setAttribute("aria-pressed", String(item === button)));
+        invalidate();
+    }));
+    form.querySelector("[data-json-clear]").addEventListener("click", () => {
+        source.value = "";
+        invalidate();
+        source.focus();
+    });
+    file.addEventListener("change", async () => {
+        const selected = file.files[0];
+        file.value = "";
+        if (!selected) return;
+        invalidate();
+        const current = revision;
+        if (!/\.json$/i.test(selected.name) || selected.size > 1024 * 1024) {
+            message("Выберите .json до 1 МБ.", true);
+            return;
+        }
+        try {
+            const value = new TextDecoder("utf-8", {fatal: true}).decode(await selected.arrayBuffer());
+            if (current !== revision) return;
+            source.value = value.replace(/^\uFEFF/, "");
+            invalidate();
+            message("Файл открыт. Выберите операцию.");
+        } catch {
+            if (current === revision) message("Файл должен быть в UTF-8.", true);
+        }
+    });
+    copy.addEventListener("click", async () => {
+        if (result === null) return;
+        const current = revision;
+        try {
+            await navigator.clipboard.writeText(result);
+            if (current === revision) message("Скопировано");
+        } catch {
+            if (current === revision) message("Не удалось скопировать результат.", true);
+        }
+    });
+    download.addEventListener("click", () => {
+        if (result === null) return;
+        const url = URL.createObjectURL(new Blob([result], {type: "application/json;charset=utf-8"}));
+        const link = document.createElement("a");
+        link.href = url;
+        link.download = "result.json";
+        link.click();
+        setTimeout(() => URL.revokeObjectURL(url), 1000);
+        message("Файл подготовлен");
+    });
+})();
diff --git a/static/js/test_data_public.js b/static/js/test_data_public.js
new file mode 100644
index 0000000..8adabae
--- /dev/null
+++ b/static/js/test_data_public.js
@@ -0,0 +1,202 @@
+(() => {
+    const root = document.querySelector("[data-td-tool]");
+    if (!root) return;
+    const one = (selector) => root.querySelector(selector);
+    const all = (selector) => Array.from(root.querySelectorAll(selector));
+    const generatorForm = one("[data-td-generator]");
+    const checksForm = one("[data-td-checks]");
+    const filesPanel = document.querySelector("[data-td-files]");
+    const limitCaption = document.querySelector("[data-td-limit]");
+    const groups = JSON.parse(document.getElementById("td-field-groups").textContent);
+    const labels = Object.fromEntries(groups.flatMap(([, fields]) => fields));
+    const csrf = generatorForm.querySelector('[name="csrfmiddlewaretoken"]').value;
+    const state = {tab: "generator", format: "table", generator: null,
+        checks: null, dirty: false, busy: false, page: 0, sequence: 0};
+
+    const setError = (message) => {
+        const error = one("[data-td-error]");
+        error.textContent = message || "";
+        error.hidden = !message;
+    };
+    const current = () => state.tab === "generator" ? state.generator : state.checks;
+    const fieldsFor = () => state.tab === "generator" ? current()?.settings.fields || [] : ["value", "purpose", "expected"];
+    const csvText = (rows, fields) => {
+        const quote = (value) => '"' + String(value ?? "").replaceAll('"', '""') + '"';
+        return [fields.map(field => quote(labels[field] || ({value: "Значение", purpose: "Назначение", expected: "Ожидаемый результат"})[field])).join(","),
+            ...rows.map(row => fields.map(field => quote(row[field])).join(","))].join("\r\n") + "\r\n";
+    };
+    const exportText = () => {
+        const rows = current()?.rows || [];
+        return state.format === "json" ? JSON.stringify(rows, null, 2) : csvText(rows, fieldsFor());
+    };
+    const cell = (tag, value) => {
+        const element = document.createElement(tag);
+        element.textContent = String(value ?? "");
+        return element;
+    };
+    const renderTable = (rows, fields) => {
+        const target = one("[data-td-table]");
+        target.replaceChildren();
+        if (!rows.length) return;
+        const table = document.createElement("table");
+        const head = document.createElement("thead");
+        const heading = document.createElement("tr");
+        fields.forEach(field => heading.append(cell("th", labels[field] || ({value: "Значение", purpose: "Назначение", expected: "Ожидаемый результат"})[field])));
+        head.append(heading);
+        table.append(head);
+        const body = document.createElement("tbody");
+        rows.slice(state.page * 10, (state.page + 1) * 10).forEach(row => {
+            const line = document.createElement("tr");
+            fields.forEach(field => line.append(cell("td", row[field])));
+            body.append(line);
+        });
+        table.append(body);
+        target.append(table);
+    };
+    const render = () => {
+        const filesActive = state.tab === "files";
+        root.hidden = filesActive;
+        if (filesPanel) filesPanel.hidden = !filesActive;
+        if (limitCaption) limitCaption.hidden = filesActive;
+        document.querySelectorAll("[data-td-tab]").forEach(button => {
+            const active = button.dataset.tdTab === state.tab;
+            button.setAttribute("aria-pressed", String(active));
+            button.classList.toggle("active", active);
+        });
+        if (filesActive) return;
+        const result = current();
+        const rows = result?.rows || [];
+        const hasRows = rows.length > 0;
+        generatorForm.hidden = state.tab !== "generator";
+        checksForm.hidden = state.tab !== "checks";
+        all("[data-td-format]").forEach(button => {
+            const active = button.dataset.tdFormat === state.format;
+            button.setAttribute("aria-pressed", String(active));
+            button.classList.toggle("active", active);
+        });
+        one("[data-td-new]").disabled = state.busy;
+        one("[data-td-copy]").disabled = state.busy || !hasRows;
+        one("[data-td-download]").disabled = state.busy || !hasRows;
+        one("[data-td-generate]").disabled = state.busy;
+        one("[data-td-build-checks]").disabled = state.busy;
+        one("[data-td-origin]").textContent = "Временный результат";
+        one("[data-td-meta]").textContent = hasRows ? `${rows.length} записей` : "Нет результата";
+        const pagination = one("[data-td-pagination]");
+        pagination.hidden = state.format !== "table" || rows.length <= 10;
+        const pages = Math.max(1, Math.ceil(rows.length / 10));
+        if (state.page >= pages) state.page = pages - 1;
+        one("[data-td-page]").textContent = `${state.page + 1} из ${pages}`;
+        one("[data-td-prev]").disabled = state.page <= 0;
+        one("[data-td-next]").disabled = state.page >= pages - 1;
+        one("[data-td-table]").hidden = state.format !== "table";
+        one("[data-td-code]").hidden = state.format === "table";
+        if (state.format === "table") renderTable(rows, fieldsFor());
+        else one("[data-td-code]").textContent = hasRows ? exportText() : "";
+        if (state.tab === "generator" && state.dirty && state.generator)
+            one("[data-td-status]").textContent = "Настройки изменены. Сгенерируйте новый результат.";
+    };
+    const post = async (url, data) => {
+        const response = await fetch(url, {method: "POST", credentials: "same-origin",
+            headers: {"Content-Type": "application/json", "X-CSRFToken": csrf}, body: JSON.stringify(data)});
+        const payload = await response.json();
+        if (!response.ok || !payload.ok) throw new Error(payload.error || "Запрос не выполнен.");
+        return payload;
+    };
+    const setBusy = (busy) => {
+        state.busy = busy;
+        all("[data-td-generator] input, [data-td-generator] select, [data-td-checks] input, [data-td-checks] select")
+            .forEach(control => { if (control.type !== "hidden") control.disabled = busy; });
+        render();
+    };
+    const generatorSettings = () => ({fields: all('[name="fields"]:checked').map(input => input.value),
+        count: generatorForm.querySelector('[name="count"]').value,
+        locale: generatorForm.querySelector('[name="locale"]').value,
+        password_length: generatorForm.querySelector('[name="password_length"]').value});
+    const checksSettings = () => ({type: checksForm.querySelector('[name="type"]').value,
+        required: checksForm.querySelector('[name="required"]').checked,
+        trim: checksForm.querySelector('[name="trim"]').value,
+        phone_locale: checksForm.querySelector('[name="phone_locale"]').value,
+        min_length: checksForm.querySelector('[name="min_length"]').value,
+        max_length: checksForm.querySelector('[name="max_length"]').value,
+        min: checksForm.querySelector('[name="min"]').value,
+        max: checksForm.querySelector('[name="max"]').value});
+
+    generatorForm.addEventListener("submit", async event => {
+        event.preventDefault();
+        if (state.busy) return;
+        setError("");
+        const version = ++state.sequence;
+        setBusy(true);
+        one("[data-td-status]").textContent = "Генерация…";
+        try {
+            const payload = await post(root.dataset.generateUrl, {settings: generatorSettings()});
+            if (version !== state.sequence) return;
+            state.generator = {settings: payload.settings, rows: payload.rows};
+            state.dirty = false;
+            state.page = 0;
+            one("[data-td-status]").textContent = `Готово · ${payload.rows.length} записей · ${payload.size_bytes} байт`;
+        } catch (error) { setError(error.message); one("[data-td-status]").textContent = "Предыдущий результат сохранён на экране."; }
+        finally { setBusy(false); }
+    });
+    checksForm.addEventListener("submit", async event => {
+        event.preventDefault();
+        if (state.busy) return;
+        setError("");
+        const version = ++state.sequence;
+        setBusy(true);
+        one("[data-td-status]").textContent = "Подготовка проверок…";
+        try {
+            const payload = await post(root.dataset.checksUrl, {settings: checksSettings()});
+            if (version !== state.sequence) return;
+            state.checks = {rows: payload.rows};
+            state.page = 0;
+            one("[data-td-status]").textContent = "Проверки готовы. Результат доступен до закрытия страницы.";
+        } catch (error) { setError(error.message); }
+        finally { setBusy(false); }
+    });
+    generatorForm.addEventListener("input", () => { if (state.generator) state.dirty = true; render(); });
+    generatorForm.addEventListener("change", () => { if (state.generator) state.dirty = true; render(); });
+    const passwordToggle = () => {
+        one("[data-td-password-length]").hidden = !generatorForm.querySelector('[name="fields"][value="password"]').checked;
+    };
+    generatorForm.addEventListener("change", passwordToggle);
+    checksForm.querySelector("[data-td-check-type]").addEventListener("change", event => {
+        const kind = event.target.value;
+        one("[data-td-length]").hidden = kind !== "text";
+        one("[data-td-range]").hidden = !["date", "number"].includes(kind);
+        one("[data-td-phone]").hidden = kind !== "phone";
+        if (kind === "date") { checksForm.querySelector('[name="min"]').value = "2000-01-01";
+            checksForm.querySelector('[name="max"]').value = "2030-12-31"; }
+        if (kind === "number") { checksForm.querySelector('[name="min"]').value = "0";
+            checksForm.querySelector('[name="max"]').value = "100"; }
+    });
+    document.querySelectorAll("[data-td-tab]").forEach(button => button.addEventListener("click", () => {
+        state.tab = button.dataset.tdTab; state.page = 0; setError(""); render();
+    }));
+    all("[data-td-format]").forEach(button => button.addEventListener("click", () => {
+        state.format = button.dataset.tdFormat; state.page = 0; render();
+    }));
+    one("[data-td-prev]").addEventListener("click", () => { state.page--; render(); });
+    one("[data-td-next]").addEventListener("click", () => { state.page++; render(); });
+    one("[data-td-copy]").addEventListener("click", async () => {
+        try { await navigator.clipboard.writeText(exportText()); one("[data-td-status]").textContent = "Весь набор скопирован."; }
+        catch { setError("Не удалось скопировать результат."); }
+    });
+    one("[data-td-download]").addEventListener("click", () => {
+        const isJson = state.format === "json";
+        const blob = new Blob([exportText()], {type: isJson ? "application/json;charset=utf-8" : "text/csv;charset=utf-8"});
+        const url = URL.createObjectURL(blob);
+        const link = document.createElement("a");
+        link.href = url; link.download = "test-data." + (isJson ? "json" : "csv");
+        document.body.append(link); link.click(); link.remove();
+        setTimeout(() => URL.revokeObjectURL(url), 1000);
+    });
+    one("[data-td-new]").addEventListener("click", () => {
+        if (state.busy) return;
+        state.generator = null; state.dirty = false; state.page = 0;
+        one("[data-td-status]").textContent = "Настройте поля и сгенерируйте новый набор.";
+        setError(""); render();
+    });
+    passwordToggle();
+    render();
+})();
