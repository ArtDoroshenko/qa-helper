+"""Default stateless settings for the public site."""
+
+import os
+import secrets
+from pathlib import Path
+
+from django.core.exceptions import ImproperlyConfigured, ValidationError
+from django.core.validators import DomainNameValidator
+
+
+BASE_DIR = Path(__file__).resolve().parent.parent
+debug_value = os.environ.get("DJANGO_PUBLIC_DEBUG", os.environ.get("DJANGO_DEBUG", "0")).lower()
+if os.environ.get("DJANGO_PUBLIC_PRODUCTION") == "1" and debug_value not in {"0", "false"}:
+    raise ImproperlyConfigured("Production requires DJANGO_PUBLIC_DEBUG=0.")
+DEBUG = debug_value in {"1", "true"}
+SECRET_KEY = os.environ.get("DJANGO_PUBLIC_SECRET_KEY") or os.environ.get("DJANGO_SECRET_KEY")
+if not SECRET_KEY:
+    if not DEBUG:
+        raise ImproperlyConfigured("DJANGO_PUBLIC_SECRET_KEY is required outside local debug mode.")
+    SECRET_KEY = secrets.token_urlsafe(48)
+if not DEBUG and (len(SECRET_KEY) < 50 or SECRET_KEY.startswith("replace-") or SECRET_KEY.startswith("django-insecure-")):
+    raise ImproperlyConfigured("Set a long random Django secret key for the public site.")
+
+ALLOWED_HOSTS = [host.strip() for host in os.environ.get("DJANGO_PUBLIC_ALLOWED_HOSTS", os.environ.get("DJANGO_ALLOWED_HOSTS", "localhost,127.0.0.1,testserver")).split(",") if host.strip()]
+CSRF_TRUSTED_ORIGINS = [origin.strip() for origin in os.environ.get("DJANGO_PUBLIC_CSRF_TRUSTED_ORIGINS", os.environ.get("DJANGO_CSRF_TRUSTED_ORIGINS", "")).split(",") if origin.strip()]
+if os.environ.get("DJANGO_PUBLIC_PRODUCTION") == "1":
+    site_domain = os.environ.get("SITE_DOMAIN", "")
+    try:
+        DomainNameValidator(accept_idna=False)(site_domain)
+    except ValidationError as error:
+        raise ImproperlyConfigured("Set SITE_DOMAIN to a DNS hostname.") from error
+    if ALLOWED_HOSTS != [site_domain] or CSRF_TRUSTED_ORIGINS != [f"https://{site_domain}"]:
+        raise ImproperlyConfigured("Production host and HTTPS CSRF origin must match SITE_DOMAIN.")
+    if os.environ.get("DJANGO_TRUST_X_FORWARDED_PROTO") != "1":
+        raise ImproperlyConfigured("Production requires the Caddy HTTPS proxy setting.")
+ROOT_URLCONF = "config.urls_public"
+INSTALLED_APPS = ["django.contrib.staticfiles"]
+MIDDLEWARE = [
+    "django.middleware.security.SecurityMiddleware",
+    "django.middleware.common.CommonMiddleware",
+    "config.public_limits.PublicLimitsMiddleware",
+    "django.middleware.csrf.CsrfViewMiddleware",
+    "django.middleware.clickjacking.XFrameOptionsMiddleware",
+]
+TEMPLATES = [{
+    "BACKEND": "django.template.backends.django.DjangoTemplates",
+    "DIRS": [BASE_DIR / "templates"],
+    "APP_DIRS": True,
+    "OPTIONS": {"context_processors": ["django.template.context_processors.request"]},
+}]
+DATABASES = {"default": {"ENGINE": "django.db.backends.dummy"}}
+FILE_UPLOAD_HANDLERS = ["django.core.files.uploadhandler.MemoryFileUploadHandler"]
+FILE_UPLOAD_MAX_MEMORY_SIZE = 16 * 1024 * 1024
+DATA_UPLOAD_MAX_MEMORY_SIZE = 16 * 1024 * 1024
+DATA_UPLOAD_MAX_NUMBER_FIELDS = 100
+DATA_UPLOAD_MAX_NUMBER_FILES = 1
+LANGUAGE_CODE = "ru"
+TIME_ZONE = "Europe/Moscow"
+USE_I18N = True
+USE_TZ = True
+STATIC_URL = "static/"
+STATICFILES_DIRS = [BASE_DIR / "static"]
+STATIC_ROOT = BASE_DIR / "staticfiles"
+CSRF_COOKIE_SECURE = not DEBUG
+CSRF_COOKIE_HTTPONLY = True
+SECURE_SSL_REDIRECT = not DEBUG
+SECURE_CONTENT_TYPE_NOSNIFF = True
+SECURE_REFERRER_POLICY = "no-referrer"
+SECURE_HSTS_SECONDS = int(os.environ.get("DJANGO_SECURE_HSTS_SECONDS", "0")) if not DEBUG else 0
+SECURE_HSTS_INCLUDE_SUBDOMAINS = os.environ.get("DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS") == "True"
+SECURE_HSTS_PRELOAD = os.environ.get("DJANGO_SECURE_HSTS_PRELOAD") == "True"
+if os.environ.get("DJANGO_TRUST_X_FORWARDED_PROTO") == "1":
+    SECURE_PROXY_SSL_HEADER = ("HTTP_X_FORWARDED_PROTO", "https")
diff --git a/config/tests_public.py b/config/tests_public.py
new file mode 100644
index 0000000..b3732d8
--- /dev/null
+++ b/config/tests_public.py
@@ -0,0 +1,249 @@
+import base64
+import json
+import random
+import struct
+import zlib
+from urllib.parse import urlencode
+
+from django.conf import settings
+from django.core.files.uploadedfile import SimpleUploadedFile
+from django.test import Client, SimpleTestCase
+from django.urls import Resolver404, get_resolver, resolve
+
+from config.public_limits import MAX_PUBLIC_BODY_BYTES, MAX_TEST_DATA_BODY_BYTES, MAX_URLENCODED_BODY_BYTES, TEST_DATA_PATHS
+from config.upload_validation import MAX_FILENAME_LENGTH, MAX_UPLOAD_SIZE
+from materials.base64_tools import MAX_DATA_URL_HEADER_LENGTH
+
+
+PAGES = ("/", "/tools/base64/", "/tools/json/", "/tools/test-data/", "/tools/text/")
+API = ("/tools/base64/download/", "/tools/json/process/", "/tools/json/download/",
+       "/tools/test-data/generate/", "/tools/test-data/checks/")
+PRIVATE = ("/admin/", "/accounts/login/", "/accounts/profile/", "/notes/", "/materials/",
+           "/tools/json/save/", "/tools/test-data/save/", "/materials/json/1/delete/")
+
+
+def png_image(side):
+    def chunk(kind, data):
+        return struct.pack(">I", len(data)) + kind + data + struct.pack(">I", zlib.crc32(kind + data))
+
+    rng = random.Random(10)
+    rows = b"".join(b"\x00" + rng.randbytes(side * 3) for _ in range(side))
+    header = struct.pack(">2I5B", side, side, 8, 2, 0, 0, 0)
+    return b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", header) + chunk(b"IDAT", zlib.compress(rows, level=0)) + chunk(b"IEND", b"")
+
+
+class PublicSiteTests(SimpleTestCase):
+    def test_public_routing_uses_no_database_or_account_apps(self):
+        self.assertEqual(settings.DATABASES["default"]["ENGINE"], "django.db.backends.dummy")
+        self.assertNotIn("django.contrib.auth", settings.INSTALLED_APPS)
+        self.assertNotIn("django.contrib.sessions", settings.INSTALLED_APPS)
+        self.assertEqual({pattern.name for pattern in get_resolver().url_patterns}, {
+            "home", "healthcheck", "json_tool", "json_process", "json_download",
+            "base64_tool", "base64_download", "test_data_tool", "test_data_generate",
+            "test_data_checks", "text_tool",
+        })
+        for path in PRIVATE:
+            with self.subTest(path=path), self.assertRaises(Resolver404):
+                resolve(path)
+
+    def test_pages_open_directly_and_exclude_saved_materials(self):
+        client = Client()
+        for path in PAGES:
+            with self.subTest(path=path):
+                response = client.get(path)
+                self.assertEqual(response.status_code, 200)
+                self.assertIn("no-store", response["Cache-Control"])
+                body = response.content.decode()
+                for forbidden in ("Сохранить в материалы", "Мои материалы", "Мои наборы", "/accounts/", "/notes/"):
+                    self.assertNotIn(forbidden, body)
+                self.assertNotIn("sessionid", response.cookies)
+        self.assertIn("Base64", client.get("/").content.decode())
+        self.assertEqual(client.get("/healthz/").content, b"ok")
+        for path in API:
+            self.assertEqual(client.get(path).status_code, 405)
+
+    def test_stateless_processing_and_download(self):
+        client = Client()
+        encoded = client.post("/tools/base64/", {"operation": "encode", "text": "hello"})
+        self.assertEqual(encoded.status_code, 200)
+        self.assertEqual(encoded.content, b"aGVsbG8=")
+        self.assertIn("no-store", encoded["Cache-Control"])
+        decoded = client.post("/tools/base64/download/", {
+            "mode": "decoded", "payload": "aGVsbG8=", "filename": "answer.txt",
+        })
+        self.assertEqual(decoded.content, b"hello")
+        self.assertIn("attachment", decoded["Content-Disposition"])
+        processed = client.post("/tools/json/process/", {
+            "source": '{"large":123456789012345678901234567890}', "operation": "format", "indent": 2,
+        })
+        self.assertEqual(processed.status_code, 200)
+        self.assertIn("123456789012345678901234567890", processed.json()["result"])
+        downloaded = client.post("/tools/json/download/", {
+            "source": '{"a":1}', "operation": "minify", "indent": 2,
+        })
+        self.assertEqual(downloaded.content, b'{"a":1}')
+        settings_payload = {"fields": ["name"], "count": 2, "locale": "ru_RU", "password_length": 12}
+        generated = client.post("/tools/test-data/generate/", data=json.dumps({"settings": settings_payload}),
+                                content_type="application/json")
+        self.assertEqual(generated.status_code, 200)
+        self.assertEqual(len(generated.json()["rows"]), 2)
+        self.assertNotIn("proof", generated.json())
+
+    def test_base64_returns_full_utf8_result_once_without_rendering_large_html(self):
+        client = Client(enforce_csrf_checks=True)
+        page = client.get("/tools/base64/")
+        self.assertContains(page, 'enctype="multipart/form-data"')
+        self.assertNotContains(page, 'name="payload"')
