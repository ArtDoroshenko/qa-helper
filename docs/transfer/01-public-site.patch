+                response = client.post("/tools/base64/", {
+                    "operation": "decode", "text": f"{header}{marker},0K8=",
+                })
+                self.assertEqual(response.status_code, expected_status)
+                if expected_status == 200:
+                    self.assertEqual(response["Content-Type"], "text/plain")
