+.bug-report-page [hidden] { display: none !important; }
+.br-workspace {
+    display: grid;
+    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
+    align-items: start;
+    gap: var(--qa-gap);
+    margin-top: var(--qa-section-gap);
+}
+.br-card {
+    display: grid;
+    gap: var(--qa-gap);
+    min-width: 0;
+    padding: var(--qa-panel-pad);
+    border: 1px solid var(--line);
+    border-radius: var(--qa-card-radius);
+    background: var(--surface);
+}
+.br-card h2 { margin: 0; font-size: 16px; font-weight: 600; }
+.br-pair { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--qa-gap); }
+.br-field { display: grid; align-content: start; gap: 6px; min-width: 0; }
+.br-field label { font-size: 13px; font-weight: 500; }
+.br-field small { margin-left: 4px; color: var(--muted); font-size: 12px; font-weight: 400; }
+.br-card input, .br-card textarea {
+    width: 100%;
+    min-width: 0;
+    min-height: var(--qa-control);
+    padding: 8px 10px;
+    border: 1px solid var(--line);
+    border-radius: var(--qa-control-radius);
+    background: var(--field);
+    color: var(--ink);
+    font: inherit;
+    line-height: 1.5;
+}
+.br-card textarea { resize: vertical; }
+.br-card [aria-invalid="true"] { border-color: var(--danger); }
+.br-hint, .br-status, .br-error { margin: 0; color: var(--muted); font-size: 12px; line-height: 1.5; }
+.br-error { color: var(--danger); }
+.br-suggestion {
+    padding: 10px;
+    border: 1px solid var(--line);
+    border-radius: var(--qa-control-radius);
+    background: var(--surface-soft);
+}
+.br-suggestion summary { cursor: pointer; }
+.br-suggestion > :not(summary) { margin-top: 10px; }
+.br-actions { display: flex; flex-wrap: wrap; gap: var(--qa-gap); }
+.br-actions button:disabled { opacity: .55; cursor: default; }
+.br-card .br-preview {
+    min-height: 260px;
+    height: clamp(260px, 55vh, 560px);
+    color: var(--ink);
+    font: 13px/1.6 ui-monospace, SFMono-Regular, Menlo, monospace;
+}
+@media (max-width: 1050px) {
+    .br-workspace { grid-template-columns: minmax(0, 1fr); }
+}
+@media (max-width: 600px) {
+    .br-pair { grid-template-columns: minmax(0, 1fr); }
+}
diff --git a/static/js/bug_report.js b/static/js/bug_report.js
new file mode 100644
index 0000000..c4d7226
--- /dev/null
+++ b/static/js/bug_report.js
@@ -0,0 +1,128 @@
+(() => {
+    "use strict";
+
+    const root = document.querySelector("[data-bug-report]");
+    const core = globalThis.QABugReport;
+    if (!root || !core) return;
+    const find = selector => root.querySelector(selector);
+    const fields = Object.fromEntries([...root.querySelectorAll("[data-br-field]")]
+        .map(input => [input.dataset.brField, input]));
+    const fieldErrors = Object.fromEntries([...root.querySelectorAll("[data-br-error]")]
+        .map(error => [error.dataset.brError, error]));
+    const suggestionNames = ["module", "action", "symptom"];
+    const reportNames = ["title", "steps", "actual", "expected", "environment", "issue"];
+    const preview = find("[data-br-preview]");
+    const status = find("[data-br-status]");
+    const copy = find("[data-br-copy]");
+    const download = find("[data-br-download]");
+    const downloadUrls = new Set();
+    let report = null;
+
+    function feedback(message, error = false) {
+        status.textContent = message;
+        status.classList.toggle("br-error", error);
+    }
+
+    function setFieldError(name, message) {
+        if (message) fields[name].setAttribute("aria-invalid", "true");
+        else fields[name].removeAttribute("aria-invalid");
+        fieldErrors[name].textContent = message || "";
+        fieldErrors[name].hidden = !message;
+    }
+
+    function check(names, errors) {
+        for (const name of names) setFieldError(name, errors[name]);
+        const firstError = names.find(name => errors[name]);
+        if (!firstError) return true;
+        feedback("Проверьте отмеченные поля.", true);
+        fields[firstError].focus();
+        return false;
+    }
+
+    function values(names) {
+        return Object.fromEntries(names.map(name => [name, fields[name].value]));
+    }
+
+    function invalidate(message = "") {
+        report = null;
+        preview.value = "";
+        copy.disabled = true;
+        download.disabled = true;
+        feedback(message);
+    }
+
+    for (const [name, input] of Object.entries(fields)) {
+        input.addEventListener("input", () => {
+            setFieldError(name);
+            invalidate(report ? "Данные изменились. Соберите отчёт заново." : "");
+        });
+    }
+
+    find("[data-br-suggest]").addEventListener("click", () => {
+        const suggestion = core.suggestTitle(values(suggestionNames));
+        if (!check(suggestionNames, suggestion.errors)) return;
+        fields.title.value = suggestion.title;
+        setFieldError("title");
+        invalidate("Заголовок предложен. Его можно редактировать.");
+        fields.title.focus();
+    });
+
+    find("[data-br-build]").addEventListener("click", () => {
+        invalidate();
+        const current = core.buildReport(values(reportNames));
+        if (!check(reportNames, current.errors)) return;
+        report = current;
+        preview.value = report.markdown;
+        copy.disabled = false;
+        download.disabled = false;
+        feedback("Отчёт готов.");
+    });
+
+    function reset(focus) {
+        for (const [name, input] of Object.entries(fields)) {
+            input.value = "";
+            setFieldError(name);
+        }
+        invalidate(focus ? "Поля очищены." : "");
+        if (focus) fields.title.focus();
+    }
+
+    find("[data-br-reset]").addEventListener("click", () => reset(true));
+
+    copy.addEventListener("click", async () => {
+        const current = report;
+        if (!current || copy.disabled) return;
+        copy.disabled = true;
+        try {
+            await navigator.clipboard.writeText(current.markdown);
+            if (report === current) feedback("Markdown скопирован.");
+        } catch {
+            if (report === current) feedback("Копирование недоступно. Выделите текст или скачайте файл.", true);
+        } finally {
+            if (report === current) copy.disabled = false;
+        }
+    });
+
+    function releaseDownload(url) {
+        if (downloadUrls.delete(url)) URL.revokeObjectURL(url);
+    }
+
+    download.addEventListener("click", () => {
+        if (!report) return;
+        const blob = new Blob([report.markdown], {type: "text/markdown;charset=utf-8"});
+        const url = URL.createObjectURL(blob);
+        downloadUrls.add(url);
+        const link = document.createElement("a");
+        link.href = url;
+        link.download = "bug-report.md";
+        document.body.append(link);
+        link.click();
+        link.remove();
+        window.setTimeout(() => releaseDownload(url), 1000);
+    });
+
+    window.addEventListener("pagehide", () => {
+        for (const url of downloadUrls) releaseDownload(url);
+        reset(false);
+    });
+})();
diff --git a/static/js/bug_report_core.js b/static/js/bug_report_core.js
new file mode 100644
index 0000000..9e806ee
--- /dev/null
+++ b/static/js/bug_report_core.js
@@ -0,0 +1,108 @@
+(() => {
+    "use strict";
+
+    const suggestionFields = Object.freeze({
+        module: {max: 60, singleLine: true, required: true},
+        action: {max: 70, singleLine: true, required: true},
+        symptom: {max: 100, singleLine: true, required: true},
+    });
+    const reportFields = Object.freeze({
+        title: {max: 240, singleLine: true, required: true},
+        steps: {max: 8000, required: true},
+        actual: {max: 4000, required: true},
+        expected: {max: 4000, required: true},
+        environment: {max: 2000},
+        issue: {max: 2048, singleLine: true},
+    });
+    const maxSteps = 50;
+    const maxStepLength = 500;
+    const disallowedControls = /[\u0000-\u0008\u000b\u000c\u000e-\u001f\u007f]/;
+
+    function tooLong(text, max) {
+        let length = 0;
+        for (const character of text) {
+            if (++length > max) return true;
+        }
+        return false;
+    }
+
+    function readFields(raw, rules) {
+        const values = {};
+        const errors = {};
+        for (const [name, rule] of Object.entries(rules)) {
+            const text = (raw[name] ?? "").replace(/\r\n?/g, "\n");
+            const trimmed = text.trim();
+            const value = rule.singleLine ? trimmed : text;
+            values[name] = trimmed ? value : "";
+            if (disallowedControls.test(text)) {
+                errors[name] = "Удалите управляющие символы.";
+            } else if (rule.required && !trimmed) {
+                errors[name] = "Заполните поле.";
+            } else if (rule.singleLine && value.includes("\n")) {
+                errors[name] = "Используйте одну строку.";
+            } else if (tooLong(value, rule.max)) {
+                errors[name] = "Не больше " + rule.max + " символов.";
+            }
+        }
+        return {values, errors};
+    }
+
+    function suggestTitle(raw) {
+        const {values, errors} = readFields(raw, suggestionFields);
+        if (Object.keys(errors).length) return {errors};
+        return {title: "[" + values.module + "] " + values.action + ": " + values.symptom, errors};
+    }
+
+    function literalInline(text) {
+        let length = 1;
+        for (const match of text.matchAll(/`+/g)) length = Math.max(length, match[0].length + 1);
+        const fence = "`".repeat(length);
+        return fence + " " + text + " " + fence;
+    }
+
+    function literalBlock(text) {
+        let length = 3;
+        for (const match of text.matchAll(/~+/g)) length = Math.max(length, match[0].length + 1);
+        const fence = "~".repeat(length);
+        return fence + "text\n" + text + (text.endsWith("\n") ? "" : "\n") + fence;
+    }
+
+    function isIssueUrl(value) {
+        if (!/^https?:\/\//i.test(value) || /[\s\\]/.test(value)) return false;
+        try {
+            const url = new URL(value);
+            return !!url.hostname && !url.username && !url.password;
+        } catch {
+            return false;
+        }
+    }
+
+    function buildReport(raw) {
+        const {values, errors} = readFields(raw, reportFields);
+        const steps = errors.steps ? [] : values.steps.split("\n").map(line => line.trim()).filter(Boolean);
+        if (steps.length > maxSteps) {
+            errors.steps = "Не больше " + maxSteps + " шагов.";
+        } else if (steps.some(step => tooLong(step, maxStepLength))) {
+            errors.steps = "Не больше " + maxStepLength + " символов в одном шаге.";
+        }
+        if (!errors.issue && values.issue && !isIssueUrl(values.issue)) {
+            errors.issue = "Укажите полный адрес http:// или https:// без логина и пароля.";
+        }
+        if (Object.keys(errors).length) return {errors};
+
+        // Literal Markdown keeps user text out of HTML, link, and block syntax.
+        const sections = [
+            "# " + literalInline(values.title),
+            "## Шаги воспроизведения\n\n" + steps.map((step, i) => (i + 1) + ". " + literalInline(step)).join("\n"),
+            "## Фактический результат\n\n" + literalBlock(values.actual),
+            "## Ожидаемый результат\n\n" + literalBlock(values.expected),
+        ];
+        if (values.environment) sections.push("## Окружение\n\n" + literalBlock(values.environment));
+        if (values.issue) sections.push("## Ссылка на задачу\n\n" + literalInline(values.issue));
+        return {markdown: sections.join("\n\n") + "\n", errors};
+    }
+
+    const api = {suggestTitle, buildReport};
+    if (typeof module !== "undefined" && module.exports) module.exports = api;
+    else globalThis.QABugReport = api;
+})();
